---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Sparkles, ArrowLeft, Search, Wand2, ArrowRight, Home, Compass, Layers, Star } from 'lucide-react';

const popularPicks = [
  { label: '5-Star Ratings', href: '/stars/ratings/', icon: '⭐' },
  { label: 'Live Animated', href: '/stars/animated/', icon: '💫' },
  { label: 'Star Stickers', href: '/stars/stickers/', icon: '✨' },
  { label: '3D & Glossy', href: '/stars/3d/', icon: '💎' },
  { label: 'Y2K Cyber', href: '/stars/y2k/', icon: '⚡' },
  { label: 'UI Star Icons', href: '/stars/interface/', icon: '🔖' },
];
---

<BaseLayout
  title="404 - Star Not Found | StarPNG"
  description="The star graphic or page you requested could not be found. Explore 340+ free transparent star PNGs, SVGs, or launch our Procedural Star Generator Studio."
  noindex={true}
>
  <div class="py-16 md:py-24 bg-[#fafafa] flex items-center justify-center min-h-[70vh]">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      
      <!-- Cosmic 404 Illustration -->
      <div class="relative w-40 h-40 mx-auto mb-8 flex items-center justify-center">
        <!-- Ambient Glow Circles -->
        <div class="absolute inset-0 bg-amber-400/20 rounded-full blur-2xl animate-pulse"></div>
        <div class="absolute w-28 h-28 bg-purple-500/15 rounded-full blur-xl"></div>
        
        <!-- SVG Lost Star Graphic -->
        <svg viewBox="0 0 160 160" class="w-full h-full relative z-10 drop-shadow-md" xmlns="http://www.w3.org/2000/svg">
          <!-- Dashed Orbit Ring -->
          <circle cx="80" cy="80" r="70" fill="none" stroke="#E5E7EB" stroke-width="2" stroke-dasharray="6 6" />
          <circle cx="80" cy="80" r="48" fill="none" stroke="#FDE68A" stroke-width="1.5" stroke-dasharray="4 4" class="animate-spin" style="animation-duration: 25s;" />

          <!-- Background Faint Constellation Lines -->
          <line x1="30" y1="40" x2="80" y2="80" stroke="#CBD5E1" stroke-width="1" stroke-dasharray="2 2" />
          <line x1="130" y1="45" x2="80" y2="80" stroke="#CBD5E1" stroke-width="1" stroke-dasharray="2 2" />
          <line x1="80" y1="80" x2="125" y2="125" stroke="#CBD5E1" stroke-width="1" stroke-dasharray="2 2" />

          <!-- Mini Constellation Points -->
          <circle cx="30" cy="40" r="3.5" fill="#94A3B8" />
          <circle cx="130" cy="45" r="4" fill="#94A3B8" />
          <circle cx="125" cy="125" r="3" fill="#94A3B8" />
          <circle cx="35" cy="120" r="3.5" fill="#94A3B8" />

          <!-- Central Pulsing 4-Point Star Burst with missing ray -->
          <g transform="translate(80,80) scale(0.9)">
            <!-- Outer Gold Rays -->
            <polygon points="0,-48 10,-12 46,0 10,12 0,48 -10,12 -46,0 -10,-12" fill="#F59E0B" opacity="0.9" />
            <!-- Inner Faceted Shading -->
            <polygon points="0,-48 10,-12 0,0" fill="#FDE68A" />
            <polygon points="46,0 10,12 0,0" fill="#D97706" />
            <polygon points="0,48 -10,12 0,0" fill="#B45309" />
            <polygon points="-46,0 -10,-12 0,0" fill="#FBBF24" />
            
            <!-- Confused / Question Sparkle -->
            <circle cx="0" cy="0" r="6" fill="#171717" />
            <circle cx="-2" cy="-2" r="2" fill="white" />
          </g>

          <!-- Little floating question mark -->
          <text x="110" y="50" font-family="monospace" font-size="20" font-weight="bold" fill="#7C3AED">?</text>
          <text x="40" y="65" font-family="monospace" font-size="14" font-weight="bold" fill="#F59E0B" opacity="0.8">✦</text>
        </svg>
      </div>

      <!-- Error Code Pill & Headings -->
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-red-50 border border-red-200 text-red-700 text-xs font-mono uppercase tracking-wider mb-3">
        <span>Error 404 &bull; Celestial Void</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#171717] tracking-tight mb-3">
        Constellation Not Found
      </h1>

      <p class="text-sm sm:text-base text-[#4d4d4d] leading-relaxed max-w-md mx-auto mb-8">
        The star image, sticker, or vector asset you are looking for may have gone supernova, been renamed, or never existed in this quadrant.
      </p>

      <!-- Search Box to Find Star Graphic Directly -->
      <div class="max-w-md mx-auto mb-8">
        <form action="/" method="get" class="relative flex items-center">
          <Search class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-[#8f8f8f]" />
          <input
            type="text"
            name="q"
            placeholder="Search 340+ stars (e.g. gold, 3D, sticker, 5-star)..."
            class="w-full pl-10 pr-24 py-2.5 text-sm bg-white border border-[#ebebeb] rounded-full text-[#171717] placeholder:text-[#8f8f8f] focus:outline-none focus:border-[#171717] focus:ring-1 focus:ring-[#171717] shadow-xs"
          />
          <button
            type="submit"
            class="absolute right-1.5 top-1/2 -translate-y-1/2 px-4 py-1.5 rounded-full bg-[#171717] text-white text-xs font-semibold hover:bg-black transition-colors cursor-pointer"
          >
            Find Star
          </button>
        </form>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3 mb-10">
        <a
          href="/"
          class="px-5 py-2.5 rounded-full bg-[#171717] text-white text-xs font-semibold hover:bg-black transition-all flex items-center gap-2 shadow-xs"
        >
          <Home class="w-3.5 h-3.5" /> Return Home
        </a>
        <a
          href="/generator/"
          class="px-5 py-2.5 rounded-full bg-white border border-[#ebebeb] hover:border-[#171717] text-xs font-semibold text-[#171717] transition-all flex items-center gap-2 shadow-xs"
        >
          <Wand2 class="w-3.5 h-3.5 text-amber-500" /> Open Star Generator Studio
        </a>
      </div>

      <!-- Popular Star Categories Cloud -->
      <div class="pt-8 border-t border-[#ebebeb]">
        <span class="text-xs font-mono uppercase tracking-wider text-[#8f8f8f] block mb-3">
          Popular Star Collections
        </span>
        <div class="flex flex-wrap items-center justify-center gap-2">
          {popularPicks.map((pick) => (
            <a
              href={pick.href}
              class="px-3.5 py-1.5 rounded-full bg-white border border-[#ebebeb] hover:border-[#171717] text-xs font-medium text-[#4d4d4d] hover:text-[#171717] transition-all flex items-center gap-1.5 shadow-2xs"
            >
              <span>{pick.icon}</span>
              <span>{pick.label}</span>
            </a>
          ))}
        </div>
      </div>

    </div>
  </div>
</BaseLayout>
