---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AssetCopyButton from '../../components/AssetCopyButton';
import { STAR_ASSETS, CATEGORIES, STYLES, USE_CASES, INDUSTRIES, getStarsByCategory, type StarAsset } from '../../data/stars';
import { injectColorShades } from '../../utils/colorUtils';
import { ArrowLeft, Tag, Sparkles, ShieldCheck, ExternalLink, FileCode, Layers, Palette, LayoutGrid, Gamepad2 } from 'lucide-react';

export function getStaticPaths() {
  return STAR_ASSETS.map((star) => ({
    params: { slug: star.slug },
    props: { star },
  }));
}

const { star } = Astro.props as { star: StarAsset };

// Inject color at build time for the static preview
const coloredSvg = injectColorShades(star.svgContent, star.defaultColor, `preview_${star.id}`);

// Related assets: same category, excluding self, max 6
const related = getStarsByCategory(star.category)
  .filter((s) => s.id !== star.id)
  .slice(0, 6);

// Category metadata lookup
const categoryLabel = CATEGORIES.find((c) => c.id === star.category)?.name ?? star.categoryName;
const styleLabel = STYLES.find((s) => s.id === star.style)?.name ?? star.style;
const useCaseLabel = USE_CASES.find((u) => u.id === star.useCase)?.name ?? star.useCase;

// Level badge config
const levelConfig = {
  basic: { label: 'Basic', cls: 'bg-emerald-50 text-emerald-700 border-emerald-200' },
  moderate: { cls: 'bg-blue-50 text-blue-700 border-blue-200', label: 'Moderate' },
  high: { cls: 'bg-violet-50 text-violet-700 border-violet-200', label: 'High-Level 3D/FX' },
};
const level = levelConfig[star.level] ?? levelConfig.moderate;

// Schema
const assetSchema = {
  '@context': 'https://schema.org',
  '@type': 'ImageObject',
  'name': star.title,
  'description': star.description,
  'contentUrl': `https://starpng.com/star/${star.slug}.png`,
  'license': 'https://creativecommons.org/publicdomain/zero/1.0/',
  'acquireLicensePage': `https://starpng.com/star/${star.slug}/`,
  'creditText': 'StarPNG.com',
  'creator': { '@type': 'Organization', 'name': 'StarPNG', 'url': 'https://starpng.com/' },
  'encodingFormat': 'image/png',
  'caption': `${star.title} - free transparent PNG with 100% real alpha channel`,
  'keywords': star.tags.join(', '),
};
---

<BaseLayout
  title={`${star.title} - Free Transparent PNG Download | StarPNG`}
  description={`${star.description} 100% real alpha transparency. Free CC0 commercial use, 1-click copy to Figma/Canva, download up to 4K 2048px PNG or SVG vector.`}
  keywords={star.tags.join(', ')}
  schema={assetSchema}
>
  <div class="bg-[#fafafa] min-h-screen">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">

      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-[#8f8f8f] mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#171717] transition-colors flex items-center gap-1">
          <ArrowLeft class="w-3.5 h-3.5" /> StarPNG
        </a>
        <span>/</span>
        <a href={`/stars/${star.category}/`} class="hover:text-[#171717] transition-colors">
          {categoryLabel}
        </a>
        <span>/</span>
        <span class="text-[#171717] font-medium truncate max-w-[200px]">{star.title}</span>
      </nav>

      <!-- Main Content Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">

        <!-- Left: SVG Preview Panel -->
        <div class="space-y-4">
          <!-- Main preview card -->
          <div
            class="aspect-square bg-white rounded-2xl border border-[#ebebeb] shadow-xs flex items-center justify-center p-10 relative overflow-hidden"
            style="background-image: radial-gradient(circle at 25px 25px, #f0f0f0 2px, transparent 0); background-size: 25px 25px;"
          >
            <!-- Checkerboard label -->
            <div class="absolute top-3 right-3 text-[10px] font-mono text-[#8f8f8f] bg-white/80 px-2 py-0.5 rounded border border-[#ebebeb]">
              transparent bg
            </div>
            <svg
              viewBox={star.viewBox}
              xmlns="http://www.w3.org/2000/svg"
              class="w-full h-full max-w-[320px] max-h-[320px]"
              set:html={coloredSvg}
            />
          </div>

          <!-- Solid white background preview -->
          <div class="aspect-[3/1] bg-white rounded-xl border border-[#ebebeb] flex items-center justify-center gap-8 px-8">
            <div class="text-[10px] text-[#8f8f8f] font-mono text-center">
              <div class="w-12 h-12 mx-auto mb-1 flex items-center justify-center">
                <svg viewBox={star.viewBox} xmlns="http://www.w3.org/2000/svg" class="w-full h-full" set:html={coloredSvg} />
              </div>
              on white
            </div>
            <div class="text-[10px] text-[#8f8f8f] font-mono text-center">
              <div class="w-12 h-12 mx-auto mb-1 flex items-center justify-center bg-[#171717] rounded-lg p-1">
                <svg viewBox={star.viewBox} xmlns="http://www.w3.org/2000/svg" class="w-full h-full" set:html={coloredSvg} />
              </div>
              on dark
            </div>
            <div class="text-[10px] text-[#8f8f8f] font-mono text-center">
              <div class="w-12 h-12 mx-auto mb-1 flex items-center justify-center bg-gradient-to-br from-violet-500 to-pink-500 rounded-lg p-1">
                <svg viewBox={star.viewBox} xmlns="http://www.w3.org/2000/svg" class="w-full h-full" set:html={coloredSvg} />
              </div>
              on gradient
            </div>
          </div>
        </div>

        <!-- Right: Asset Info + Actions -->
        <div class="space-y-6">
          <!-- Faceted Badges: Category, Style, Function, Format, Level -->
          <div class="flex items-center gap-2 flex-wrap">
            <a
              href={`/stars/${star.category}/`}
              class="inline-flex items-center gap-1.5 text-[11px] font-mono uppercase tracking-wider px-2.5 py-1 rounded-full bg-amber-50 text-amber-800 border border-amber-200 hover:bg-amber-100 transition-colors"
            >
              <Sparkles class="w-3 h-3 text-amber-500" />
              {categoryLabel}
            </a>

            {star.style && (
              <span class="inline-flex items-center gap-1 text-[11px] font-mono uppercase tracking-wider px-2.5 py-1 rounded-full bg-purple-50 text-purple-800 border border-purple-200">
                <Palette class="w-3 h-3 text-purple-600" />
                Style: {styleLabel}
              </span>
            )}

            {star.useCase && (
              <span class="inline-flex items-center gap-1 text-[11px] font-mono uppercase tracking-wider px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200">
                <LayoutGrid class="w-3 h-3 text-emerald-600" />
                {useCaseLabel}
              </span>
            )}

            <span class="inline-flex items-center gap-1 text-[11px] font-mono uppercase tracking-wider px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 border border-blue-200">
              <FileCode class="w-3 h-3 text-blue-500" />
              {star.primaryFormat === 'png' ? '32-Bit PNG' : star.isAnimated ? 'Animated SVG' : 'Vector SVG'}
            </span>

            <span class={`inline-flex items-center text-[11px] font-mono uppercase tracking-wider px-2.5 py-1 rounded-full border ${level.cls}`}>
              {level.label}
            </span>

            {star.isAnimated && (
              <span class="inline-flex items-center gap-1 text-[11px] font-mono px-2.5 py-1 rounded-full bg-green-50 text-green-700 border border-green-200">
                <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
                Live Animated
              </span>
            )}
          </div>

          <!-- Title -->
          <div>
            <h1 class="text-2xl sm:text-3xl font-bold text-[#171717] tracking-tight leading-tight">
              {star.title}
            </h1>
            {star.searchVolume && (
              <p class="mt-1.5 text-xs font-mono text-[#8f8f8f]">
                ~{star.searchVolume} monthly searches
              </p>
            )}
          </div>

          <!-- Description -->
          <p class="text-sm text-[#4d4d4d] leading-relaxed">
            {star.description}
          </p>

          <!-- Trust badges -->
          <div class="grid grid-cols-2 gap-2.5">
            <div class="p-3 rounded-xl bg-[#fafafa] border border-[#ebebeb] flex items-center gap-2">
              <ShieldCheck class="w-4 h-4 text-emerald-500 shrink-0" />
              <div>
                <div class="text-xs font-semibold text-[#171717]">100% True Alpha</div>
                <div class="text-[10px] text-[#8f8f8f]">Real transparent PNG</div>
              </div>
            </div>
            <div class="p-3 rounded-xl bg-[#fafafa] border border-[#ebebeb] flex items-center gap-2">
              <Sparkles class="w-4 h-4 text-amber-500 shrink-0" />
              <div>
                <div class="text-xs font-semibold text-[#171717]">Free CC0 License</div>
                <div class="text-[10px] text-[#8f8f8f]">No attribution needed</div>
              </div>
            </div>
          </div>

          <!-- Copy & Download Actions (lightweight React island) -->
          <div class="p-5 rounded-xl bg-white border border-[#ebebeb] shadow-xs">
            <h2 class="text-sm font-semibold text-[#171717] mb-4">Download or Copy</h2>
            <AssetCopyButton
              client:visible
              svgContent={star.svgContent}
              defaultColor={star.defaultColor}
              viewBox={star.viewBox}
              title={star.title}
              slug={star.slug}
            />
          </div>

          <!-- Generator CTA -->
          <div class="p-4 rounded-xl bg-[#171717] text-white flex items-center justify-between gap-4">
            <div>
              <div class="text-xs font-semibold mb-0.5">Want a custom version?</div>
              <div class="text-[11px] text-[#8f8f8f]">Adjust points, color, depth & export format</div>
            </div>
            <a
              href="/generator"
              class="shrink-0 flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-amber-400 text-[#171717] text-xs font-semibold hover:bg-amber-300 transition-colors"
            >
              Open Generator <ExternalLink class="w-3 h-3" />
            </a>
          </div>

          <!-- Semantic Industry & Utility Tags -->
          {star.industries && star.industries.length > 0 && (
            <div>
              <div class="flex items-center gap-1.5 text-[11px] font-mono text-[#8f8f8f] uppercase tracking-wider mb-2">
                <Gamepad2 class="w-3 h-3 text-blue-500" /> Industry & Use Cases
              </div>
              <div class="flex flex-wrap gap-1.5">
                {star.industries.map((indKey) => {
                  const ind = INDUSTRIES.find((i) => i.id === indKey);
                  return (
                    <span class="inline-flex items-center gap-1 text-xs px-3 py-1 rounded-full bg-blue-50 text-blue-900 border border-blue-200 font-medium">
                      <span>{ind?.emoji}</span>
                      <span>{ind?.name}</span>
                    </span>
                  );
                })}
              </div>
            </div>
          )}

          <!-- Tags -->
          {star.tags.length > 0 && (
            <div>
              <div class="flex items-center gap-1.5 text-[11px] font-mono text-[#8f8f8f] uppercase tracking-wider mb-2">
                <Tag class="w-3 h-3" /> Search Keywords
              </div>
              <div class="flex flex-wrap gap-1.5">
                {star.tags.map((tag) => (
                  <span class="text-[11px] px-2.5 py-1 rounded-full bg-[#fafafa] border border-[#ebebeb] text-[#4d4d4d]">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>

      <!-- Related Assets Section -->
      {related.length > 0 && (
        <section class="mt-14 pt-10 border-t border-[#ebebeb]">
          <div class="flex items-center justify-between mb-6">
            <div>
              <span class="font-mono text-xs text-[#8f8f8f] uppercase tracking-wider block mb-1">More from this category</span>
              <h2 class="text-xl font-bold text-[#171717]">Related {categoryLabel}</h2>
            </div>
            <a
              href={`/stars/${star.category}/`}
              class="text-xs font-medium text-[#4d4d4d] hover:text-[#171717] flex items-center gap-1 transition-colors"
            >
              View all <ExternalLink class="w-3 h-3" />
            </a>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
            {related.map((rel) => {
              const relColored = injectColorShades(rel.svgContent, rel.defaultColor, `related_${rel.id}`);
              return (
                <a
                  href={`/star/${rel.slug}/`}
                  class="group block"
                >
                  <div class="aspect-square bg-white rounded-xl border border-[#ebebeb] p-3 flex items-center justify-center group-hover:border-[#171717] group-hover:shadow-sm transition-all">
                    <svg
                      viewBox={rel.viewBox}
                      xmlns="http://www.w3.org/2000/svg"
                      class="w-full h-full"
                      set:html={relColored}
                    />
                  </div>
                  <p class="mt-1.5 text-[11px] text-[#4d4d4d] truncate group-hover:text-[#171717] transition-colors">
                    {rel.title}
                  </p>
                </a>
              );
            })}
          </div>
        </section>
      )}

      <!-- SEO block -->
      <section class="mt-14 pt-8 border-t border-[#ebebeb]">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs text-[#8f8f8f]">
          <div>
            <div class="font-semibold text-[#171717] mb-1">File Format</div>
            <p>Available as transparent PNG (up to 4K 2048px) and raw vector SVG. Both formats use the real 32-bit alpha channel with zero baked-in background.</p>
          </div>
          <div>
            <div class="font-semibold text-[#171717] mb-1">License</div>
            <p>Creative Commons CC0 Public Domain. Use freely in personal projects, commercial products, client work, print, and web applications. No attribution required.</p>
          </div>
          <div>
            <div class="font-semibold text-[#171717] mb-1">Compatibility</div>
            <p>Paste directly into Figma, Canva, Adobe XD, Photoshop, Illustrator, Google Slides, and PowerPoint using the 1-click PNG clipboard copy.</p>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
