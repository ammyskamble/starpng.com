---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Mail, MessageSquare, Clock, MapPin, ArrowLeft, Send, CheckCircle2, ShieldCheck, Sparkles } from 'lucide-react';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  'name': 'Contact Us | StarPNG',
  'description': 'Contact the StarPNG team. Submit support inquiries, licensing questions, partnership proposals, or copyright notices.',
  'url': 'https://starpng.com/contact/',
  'publisher': {
    '@type': 'Organization',
    'name': 'StarPNG',
    'url': 'https://starpng.com/'
  }
};
---

<BaseLayout
  title="Contact Us | StarPNG"
  description="Get in touch with StarPNG. Reach out for support, licensing questions, commercial design partnerships, or copyright notifications."
  canonical="https://starpng.com/contact/"
  schema={contactSchema}
>
  <div class="py-12 md:py-16 bg-[#fafafa]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="mb-6 flex items-center gap-2 text-xs text-[#8f8f8f]" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#171717] transition-colors flex items-center gap-1">
          <ArrowLeft class="w-3.5 h-3.5" /> Back to Home
        </a>
        <span>/</span>
        <span class="text-[#171717] font-medium">Contact Us</span>
      </nav>

      <!-- Hero Header -->
      <div class="mb-10 p-8 md:p-10 bg-white rounded-2xl border border-[#ebebeb] shadow-xs relative overflow-hidden">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-800 border border-blue-200 text-xs font-mono uppercase tracking-wider mb-4">
          <MessageSquare class="w-3.5 h-3.5 text-blue-600" />
          <span>Support &amp; Inquiries</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold text-[#171717] tracking-tight leading-tight">
          Get in Touch With Us
        </h1>
        <p class="mt-4 text-sm sm:text-base text-[#4d4d4d] leading-relaxed max-w-2xl">
          Whether you have questions about commercial CC0 usage, need help with custom SVG vector exports, or want to report an issue, our team is here to help.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Left: Direct Channels & Address Info (1 col) -->
        <div class="space-y-4 lg:col-span-1">
          <!-- Email Support Card -->
          <div class="p-5 bg-white rounded-2xl border border-[#ebebeb] shadow-xs space-y-3">
            <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
              <Mail class="w-4 h-4" />
            </div>
            <div>
              <h3 class="font-semibold text-sm text-[#171717]">Direct Emails</h3>
              <p class="text-xs text-[#8f8f8f] mt-0.5">Click to copy or send message</p>
            </div>
            <div class="space-y-2 pt-1 text-xs">
              <div>
                <span class="text-[11px] font-mono text-[#8f8f8f] uppercase block">General &amp; Support:</span>
                <a href="mailto:support@starpng.com" class="font-medium text-blue-600 hover:underline">
                  support@starpng.com
                </a>
              </div>
              <div>
                <span class="text-[11px] font-mono text-[#8f8f8f] uppercase block">Legal &amp; Privacy:</span>
                <a href="mailto:privacy@starpng.com" class="font-medium text-blue-600 hover:underline">
                  privacy@starpng.com
                </a>
              </div>
              <div>
                <span class="text-[11px] font-mono text-[#8f8f8f] uppercase block">DMCA &amp; Copyright:</span>
                <a href="mailto:dmca@starpng.com" class="font-medium text-blue-600 hover:underline">
                  dmca@starpng.com
                </a>
              </div>
            </div>
          </div>

          <!-- Response Commitment -->
          <div class="p-5 bg-white rounded-2xl border border-[#ebebeb] shadow-xs space-y-2.5">
            <div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
              <Clock class="w-4 h-4" />
            </div>
            <h3 class="font-semibold text-sm text-[#171717]">Response Time</h3>
            <p class="text-xs text-[#4d4d4d] leading-relaxed">
              We aim to reply to all inquiries within <strong>24 to 48 business hours</strong>, Monday through Friday.
            </p>
          </div>

          <!-- Location -->
          <div class="p-5 bg-white rounded-2xl border border-[#ebebeb] shadow-xs space-y-2.5">
            <div class="w-9 h-9 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center">
              <MapPin class="w-4 h-4" />
            </div>
            <h3 class="font-semibold text-sm text-[#171717]">Corporate Office</h3>
            <p class="text-xs text-[#8f8f8f] leading-relaxed font-mono">
              StarPNG Project<br />
              100 Pine Street, Suite 1250<br />
              San Francisco, CA 94111<br />
              United States
            </p>
          </div>
        </div>

        <!-- Right: Interactive Contact Form (2 cols) -->
        <div class="lg:col-span-2 bg-white rounded-2xl border border-[#ebebeb] p-8 md:p-10 shadow-xs">
          <h2 class="text-xl font-bold text-[#171717] tracking-tight mb-2">
            Send Us a Message
          </h2>
          <p class="text-xs text-[#8f8f8f] mb-6">
            Fill out the form below and our team will get back to you promptly.
          </p>

          <form id="contact-form" class="space-y-4 text-sm" onsubmit="event.preventDefault(); document.getElementById('form-success').classList.remove('hidden'); document.getElementById('contact-form').reset();">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Name -->
              <div>
                <label for="contact-name" class="block text-xs font-semibold text-[#171717] mb-1.5 font-mono uppercase tracking-wider">
                  Your Name <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="contact-name"
                  required
                  placeholder="e.g. Sarah Connor"
                  class="w-full px-3.5 py-2.5 text-sm bg-white border border-[#ebebeb] rounded-xl text-[#171717] placeholder:text-[#8f8f8f] focus:outline-none focus:border-[#171717] focus:ring-1 focus:ring-[#171717] transition-all"
                />
              </div>

              <!-- Email -->
              <div>
                <label for="contact-email" class="block text-xs font-semibold text-[#171717] mb-1.5 font-mono uppercase tracking-wider">
                  Email Address <span class="text-red-500">*</span>
                </label>
                <input
                  type="email"
                  id="contact-email"
                  required
                  placeholder="you@company.com"
                  class="w-full px-3.5 py-2.5 text-sm bg-white border border-[#ebebeb] rounded-xl text-[#171717] placeholder:text-[#8f8f8f] focus:outline-none focus:border-[#171717] focus:ring-1 focus:ring-[#171717] transition-all"
                />
              </div>
            </div>

            <!-- Subject Category -->
            <div>
              <label for="contact-subject" class="block text-xs font-semibold text-[#171717] mb-1.5 font-mono uppercase tracking-wider">
                Inquiry Topic <span class="text-red-500">*</span>
              </label>
              <select
                id="contact-subject"
                required
                class="w-full px-3.5 py-2.5 text-sm bg-white border border-[#ebebeb] rounded-xl text-[#171717] focus:outline-none focus:border-[#171717] focus:ring-1 focus:ring-[#171717] transition-all"
              >
                <option value="general">General Inquiry / Feedback</option>
                <option value="licensing">Commercial &amp; CC0 Licensing Question</option>
                <option value="technical">Technical Issue / Bug Report</option>
                <option value="generator">Procedural Star Generator Feedback</option>
                <option value="dmca">DMCA / Copyright Notice</option>
                <option value="ads">Advertising &amp; Sponsorship</option>
              </select>
            </div>

            <!-- Message -->
            <div>
              <label for="contact-message" class="block text-xs font-semibold text-[#171717] mb-1.5 font-mono uppercase tracking-wider">
                Your Message <span class="text-red-500">*</span>
              </label>
              <textarea
                id="contact-message"
                rows="5"
                required
                placeholder="How can we help you? Please describe your inquiry in detail..."
                class="w-full px-3.5 py-2.5 text-sm bg-white border border-[#ebebeb] rounded-xl text-[#171717] placeholder:text-[#8f8f8f] focus:outline-none focus:border-[#171717] focus:ring-1 focus:ring-[#171717] transition-all"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              class="w-full sm:w-auto px-6 py-3 rounded-full bg-[#171717] text-white hover:bg-black font-semibold text-xs flex items-center justify-center gap-2 transition-all cursor-pointer shadow-xs"
            >
              <Send class="w-3.5 h-3.5" />
              <span>Send Message</span>
            </button>
          </form>

          <!-- Success Alert Placeholder -->
          <div id="form-success" class="hidden mt-4 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs flex items-center gap-2">
            <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
            <span>Thank you! Your message has been received. Our team will get back to you within 24–48 business hours.</span>
          </div>
        </div>

      </div>
    </div>
  </div>
</BaseLayout>
