---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Sparkles, RefreshCw, Home, Mail, AlertTriangle, ShieldCheck, ArrowRight, Wand2 } from 'lucide-react';

const popularPicks = [
  { label: '5-Star Ratings', href: '/stars/ratings/', icon: '⭐' },
  { label: 'Live Animated', href: '/stars/animated/', icon: '💫' },
  { label: 'Star Stickers', href: '/stars/stickers/', icon: '✨' },
  { label: '3D & Glossy', href: '/stars/3d/', icon: '💎' },
  { label: 'Procedural Generator', href: '/generator/', icon: '🪄' },
];
---

<BaseLayout
  title="500 - Solar Flare Detected (Server Error) | StarPNG"
  description="Internal server error. StarPNG servers encountered an unexpected issue. Try reloading the page or return to the home catalog."
  noindex={true}
>
  <div class="py-16 md:py-24 bg-[#fafafa] flex items-center justify-center min-h-[70vh]">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      
      <!-- Cosmic 500 Illustration: Solar Flare / Coronal Discharge -->
      <div class="relative w-40 h-40 mx-auto mb-8 flex items-center justify-center">
        <!-- Intense Solar Aura -->
        <div class="absolute inset-0 bg-orange-500/20 rounded-full blur-2xl animate-pulse"></div>
        <div class="absolute w-24 h-24 bg-amber-400/30 rounded-full blur-lg"></div>

        <!-- SVG Solar Flare Graphic -->
        <svg viewBox="0 0 160 160" class="w-full h-full relative z-10 drop-shadow-md" xmlns="http://www.w3.org/2000/svg">
          <!-- Solar Flares / Magnetic Loops -->
          <path d="M 40 40 C 20 10, 60 0, 80 30" fill="none" stroke="#F97316" stroke-width="2.5" stroke-linecap="round" opacity="0.8" />
          <path d="M 120 40 C 150 15, 160 55, 130 80" fill="none" stroke="#EA580C" stroke-width="2" stroke-linecap="round" opacity="0.7" />
          <path d="M 125 115 C 155 140, 110 160, 85 135" fill="none" stroke="#F59E0B" stroke-width="2.5" stroke-linecap="round" opacity="0.85" />
          <path d="M 35 120 C 10 145, 0 100, 30 80" fill="none" stroke="#EF4444" stroke-width="2" stroke-linecap="round" opacity="0.75" />

          <!-- Radiating Corona Hairlines -->
          <circle cx="80" cy="80" r="54" fill="none" stroke="#FED7AA" stroke-width="1.5" stroke-dasharray="3 5" />

          <!-- Center Solar Core Star -->
          <g transform="translate(80,80)">
            <!-- Outer Flare Star -->
            <polygon points="0,-46 11,-12 46,0 11,12 0,46 -11,12 -46,0 -11,-12" fill="#EA580C" />
            <!-- Inner Glowing Star -->
            <polygon points="0,-36 9,-10 36,0 9,10 0,36 -9,10 -36,0 -9,-10" fill="#F59E0B" />
            <polygon points="0,-24 6,-6 24,0 6,6 0,24 -6,6 -24,0 -6,-6" fill="#FEF08A" />
            
            <!-- Warning Symbol in Core -->
            <circle cx="0" cy="0" r="8" fill="#7C2D12" />
            <polygon points="0,-4 3,3 -3,3" fill="#FEF08A" />
          </g>

          <!-- Energy Particle Dots -->
          <circle cx="20" cy="30" r="2.5" fill="#F97316" />
          <circle cx="145" cy="35" r="3" fill="#F59E0B" />
          <circle cx="140" cy="130" r="2" fill="#EF4444" />
          <circle cx="25" cy="140" r="2.5" fill="#FBBF24" />
        </svg>
      </div>

      <!-- Error Code Pill -->
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-orange-50 border border-orange-200 text-orange-800 text-xs font-mono uppercase tracking-wider mb-3">
        <AlertTriangle class="w-3.5 h-3.5 text-orange-600" />
        <span>Error 500 &bull; Cosmic Interference</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#171717] tracking-tight mb-3">
        Solar Flare Detected
      </h1>

      <p class="text-sm sm:text-base text-[#4d4d4d] leading-relaxed max-w-md mx-auto mb-8">
        Our star rendering engine encountered an unexpected coronal disturbance. Our telemetry systems have logged the incident and our engineers are resolving it.
      </p>

      <!-- Recovery Actions -->
      <div class="flex flex-wrap items-center justify-center gap-3 mb-10">
        <button
          type="button"
          onclick="window.location.reload();"
          class="px-5 py-2.5 rounded-full bg-[#171717] text-white text-xs font-semibold hover:bg-black transition-all flex items-center gap-2 shadow-xs cursor-pointer"
        >
          <RefreshCw class="w-3.5 h-3.5" /> Reload Page
        </button>
        <a
          href="/"
          class="px-5 py-2.5 rounded-full bg-white border border-[#ebebeb] hover:border-[#171717] text-xs font-semibold text-[#171717] transition-all flex items-center gap-2 shadow-xs"
        >
          <Home class="w-3.5 h-3.5" /> Return Home
        </a>
        <a
          href="/contact/"
          class="px-5 py-2.5 rounded-full bg-white border border-[#ebebeb] hover:border-[#171717] text-xs font-semibold text-[#4d4d4d] hover:text-[#171717] transition-all flex items-center gap-2 shadow-xs"
        >
          <Mail class="w-3.5 h-3.5" /> Report Issue
        </a>
      </div>

      <!-- Status Assurance Box -->
      <div class="p-4 bg-white rounded-xl border border-[#ebebeb] max-w-md mx-auto mb-8 text-xs text-[#8f8f8f] flex items-center justify-between gap-3 text-left">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-[#171717] font-medium">All Cloudflare CDN &amp; Asset Nodes Operational</span>
        </div>
        <span class="font-mono text-[11px] text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
          99.98%
        </span>
      </div>

      <!-- Popular Star Categories Cloud -->
      <div class="pt-8 border-t border-[#ebebeb]">
        <span class="text-xs font-mono uppercase tracking-wider text-[#8f8f8f] block mb-3">
          Explore Star Assets While We Restore Orbit
        </span>
        <div class="flex flex-wrap items-center justify-center gap-2">
          {popularPicks.map((pick) => (
            <a
              href={pick.href}
              class="px-3.5 py-1.5 rounded-full bg-white border border-[#ebebeb] hover:border-[#171717] text-xs font-medium text-[#4d4d4d] hover:text-[#171717] transition-all flex items-center gap-1.5 shadow-2xs"
            >
              <span>{pick.icon}</span>
              <span>{pick.label}</span>
            </a>
          ))}
        </div>
      </div>

    </div>
  </div>
</BaseLayout>
