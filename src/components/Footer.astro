---
const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-[#fafafa] border-t border-[#ebebeb] pt-16 pb-12 text-[#4d4d4d]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-[#ebebeb]">
      <!-- Brand & Mission -->
      <div class="md:col-span-1 space-y-4">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-md bg-[#171717] text-white flex items-center justify-center">
            <svg viewBox="0 0 100 100" class="w-3.5 h-3.5 fill-amber-400">
              <polygon points="50,5 63,33 95,35 70,56 78,87 50,70 22,87 30,56 5,35 37,33" />
            </svg>
          </div>
          <span class="font-semibold text-base text-[#171717] tracking-tight">
            StarPNG<span class="text-[#8f8f8f] font-normal">.com</span>
          </span>
        </div>
        <p class="text-xs text-[#8f8f8f] leading-relaxed">
          The open repository for 100% verified transparent Star PNGs and vector SVGs. Zero fake checkerboard backgrounds, zero download countdowns, zero account gates.
        </p>
        <div class="text-[11px] font-mono text-[#8f8f8f]">
          Free for personal & commercial design projects under CC0 License.
        </div>
      </div>

      <!-- Categories Links -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-[#171717] mb-3 font-mono">
          Popular Categories
        </h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/stars/ratings/" class="hover:text-[#171717] transition-colors">5 Star Rating PNGs</a></li>
          <li><a href="/stars/y2k/" class="hover:text-[#171717] transition-colors">Y2K Cyber Stars</a></li>
          <li><a href="/stars/gold/" class="hover:text-[#171717] transition-colors">Metallic Gold Stars</a></li>
          <li><a href="/stars/aesthetic/" class="hover:text-[#171717] transition-colors">Aesthetic Sparkles</a></li>
          <li><a href="/stars/outline/" class="hover:text-[#171717] transition-colors">Star Outlines & Badges</a></li>
        </ul>
      </div>

      <!-- Design Features -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-[#171717] mb-3 font-mono">
          StarPNG Features
        </h4>
        <ul class="space-y-2 text-xs">
          <li><a href="#catalog" class="hover:text-[#171717] transition-colors">1-Click Clipboard Copy</a></li>
          <li><a href="#catalog" class="hover:text-[#171717] transition-colors">In-Browser Color Customizer</a></li>
          <li><a href="#catalog" class="hover:text-[#171717] transition-colors">4K Ultra HD Export (2048px)</a></li>
          <li><a href="#catalog" class="hover:text-[#171717] transition-colors">Scalable Vector SVG Downloads</a></li>
          <li><a href="#transparency-guide" class="hover:text-[#171717] transition-colors">Real vs Fake PNG Guide</a></li>
        </ul>
      </div>

      <!-- SEO Keywords & Resources -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-[#171717] mb-3 font-mono">
          Designer Resources
        </h4>
        <ul class="space-y-2 text-xs">
          <li><a href="#faq" class="hover:text-[#171717] transition-colors">Frequently Asked Questions</a></li>
          <li><a href="#commercial-use" class="hover:text-[#171717] transition-colors">Commercial Licensing Info</a></li>
          <li><a href="#figma-canva" class="hover:text-[#171717] transition-colors">Figma & Canva Workflow</a></li>
          <li><span class="text-[#8f8f8f]">Sitemap / RSS feeds</span></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#8f8f8f]">
      <div>
        &copy; {currentYear} StarPNG.com. All rights reserved. Crafted for creators, web developers, and designers.
      </div>
      <div class="flex items-center gap-6">
        <span>No Cookies &bull; No Trackers</span>
        <span>Ultra-fast Core Web Vitals</span>
      </div>
    </div>
  </div>
</footer>
